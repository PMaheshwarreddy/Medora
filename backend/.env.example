# Copy to .env and fill in.
# Local database: the kiosk works from this, with or without internet.
# The Supabase database (session pooler URL). It is the only database.
MEDORA_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Central database (optional). Clients, sessions, reports and logs are
# mirrored to it in the background whenever the internet is available.
MEDORA_CLOUD_DATABASE_URL=
# The back office is signed in to with an email and password. The first
# account registered on a new installation becomes its administrator.
# Where uploaded knowledge files are stored.
MEDORA_DATA_DIR=data

# --- Gemini: online voice agent and reports ---
MEDORA_GEMINI_API_KEY=
# MEDORA_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# MEDORA_GEMINI_VOICE=Kore
# MEDORA_GEMINI_TEXT_MODEL=gemini-2.5-flash

# --- Offline reports ---
# MEDORA_OLLAMA_URL=http://localhost:11434
# MEDORA_OLLAMA_MODEL=qwen2.5:3b
# Local medical model for the whole report without internet (empty = summary only)
# MEDORA_OFFLINE_MODEL=medgemma:4b
# MEDORA_OFFLINE_PANEL_SIZE=2
# Behave as if offline, to rehearse the offline demo
# MEDORA_FORCE_OFFLINE=false

# --- Email the report (SMTP) ---
MEDORA_SMTP_HOST=
MEDORA_SMTP_PORT=587
MEDORA_SMTP_USER=
MEDORA_SMTP_PASSWORD=
MEDORA_SMTP_FROM=

# --- Text the report (Twilio) ---
MEDORA_TWILIO_ACCOUNT_SID=
MEDORA_TWILIO_AUTH_TOKEN=
MEDORA_TWILIO_FROM=
# MEDORA_SMS_DEFAULT_COUNTRY_CODE=+91
# MEDORA_PUBLIC_BASE_URL=https://medora.example.com

# Anyone who can open the back office may create a working account.
# Set to false on a server reachable from outside the company.
# MEDORA_REGISTRATION_OPEN=true

# Knowledge database (guideline RAG). Separate Supabase project from the app database.
MEDORA_KNOWLEDGE_DATABASE_URL=
# Reports may use sources still awaiting permission (ICMR STW, NFI, WHO list). Testing only.
MEDORA_KNOWLEDGE_TESTING_SOURCES=false
# Reports may use community (Hugging Face) data. Off until it has been evaluated.
MEDORA_KNOWLEDGE_COMMUNITY_SOURCES=false
# Model for the final report (writer, condition check, pharmacist review). Empty = MEDORA_GEMINI_TEXT_MODEL.
MEDORA_GEMINI_REPORT_MODEL=
